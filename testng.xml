<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CIB Hybrid Framework Suite" parallel="tests" thread-count="4">

    <listeners>
        <listener class-name="utils.ExtentReportManager"/>
    </listeners>

    <test name="Smoke Tests" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="@smoke"/>
        <classes>
            <class name="runners.SmokeTestRunner"/>
        </classes>
    </test>

    <test name="Regression Tests" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="@regression and not @wip"/>
        <classes>
            <class name="runners.RegressionTestRunner"/>
        </classes>
    </test>

    <test name="API Tests" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="@api"/>
        <classes>
            <class name="runners.ApiTestRunner"/>
        </classes>
    </test>

    <test name="Database Tests" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="@db"/>
        <classes>
            <class name="runners.DbTestRunner"/>
        </classes>
    </test>

    <test name="Full Suite" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="not @wip"/>
        <classes>
            <class name="runners.FullSuiteRunner"/>
        </classes>
    </test>

</suite>
